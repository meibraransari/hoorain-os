# ============================================================
# FinanceOS Environment Configuration
# Copy this file to .env and update ALL values before deploying
# ============================================================

# Application
APP_PORT=8080
NODE_ENV=production

# Frontend
NEXT_PUBLIC_API_URL=/api

# Domain (used for SSL in prod)
DOMAIN=finance.yourdomain.com

# Database (PostgreSQL)
POSTGRES_USER=financeos
POSTGRES_PASSWORD=change_this_strong_password_here
POSTGRES_DB=financeos
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_this_redis_password_here
REDIS_PORT=6379

# JWT Secrets (MUST be changed in production - use 64+ char random strings)
# Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_very_long_random_secret_string_minimum_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_string_64_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Storage Paths (customize to your server paths)
DATA_FOLDER=./data
BACKUP_PATH=./backups

# SSL Certificate Paths (production only)
SSL_CERT_PATH=./ssl

# Upload settings
MAX_UPLOAD_SIZE=50mb

# Backup retention (days)
BACKUP_RETAIN_DAYS=30

# Logging
LOG_LEVEL=info
