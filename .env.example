# ============================================================
# HoorainOS Environment Configuration
# Copy this file to .env and update ALL values before deploying
# ============================================================

# Application
NODE_ENV=production

# Domain - used for SSL in production nginx config
DOMAIN=hoorain.yourdomain.com

# Ports - change any of these to avoid conflicts with other services on your server(this change host listening port)
APP_PORT=8080
APP_PORT_SSL=443
FRONTEND_PORT=3001
BACKEND_PORT=3002
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database (PostgreSQL)
# Internal Docker service hostnames - usually no need to change these, DATABASE_HOST changes required if you want to define access from outside.
# These are the Docker network service names, not IPs
DATABASE_HOST=postgres
POSTGRES_USER=hoorainos
POSTGRES_PASSWORD=hoorainos_secret_2024
POSTGRES_DB=hoorainos
DATABASE_PORT=5432

# Backend
BACKEND_HOST=backend
FRONTEND_HOSTNAME=0.0.0.0
UPLOAD_PATH=/app/uploads

# Frontend
NEXT_PUBLIC_API_URL=/api

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=hoorainos_redis_2024

# JWT Secrets - MUST be changed in production (use 64+ char random strings)
# Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_very_long_random_secret_string_minimum_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_string_64_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Storage Paths
DATA_FOLDER=./data
BACKUP_PATH=./backups

# SSL Certificate Paths (production only)
SSL_CERT_PATH=./ssl

# Upload settings
MAX_UPLOAD_SIZE=50mb

# Backup retention in days
BACKUP_RETAIN_DAYS=30

# Logging
LOG_LEVEL=info
